# Copy to .env and fill in. Never commit .env.
# Phase 0 needs only the Telegram pair.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Phase 7 (ntfy / Discord)
NTFY_TOPIC=
DISCORD_WEBHOOK_URL=

# Phase 2+
ALCHEMY_API_KEY=
ETHERSCAN_API_KEY=
COINGECKO_DEMO_KEY=

# Phase 8 needs no key of its own. Withdrawals come from Etherscan (above) and
# validator balances from a public beacon node. beaconcha.in was the original
# plan and is not used: it refuses anonymous reads, and its free key is a
# 30-day trial capped at 1000 requests - about ten days at one call a tick.

# Docker (docker-compose.yml). Needed inside the container only.
# TZ - the digest hour (digest.hour) is counted in the container's zone. UTC by
#      default; set your own tzdata zone to get the digest at a local hour.
# PUID/PGID - owner of ./data on the host; `id -u` / `id -g`.
#TZ=Europe/Berlin
PUID=1000
PGID=1000
